# Copy to .env for local development. Values here are SYNTHETIC placeholders;
# never commit real credentials. Production sets real values via platform env
# vars or the admin Settings page.

SECRET_KEY=change-me-local-dev-only

# PayFast: checkout reads payfast_* from the Settings table.
# scripts/seed_demo.py copies these env values into EMPTY Settings rows.
PAYFAST_MERCHANT_ID=99999901
PAYFAST_MERCHANT_KEY=synthetic-merchant-key-local
PAYFAST_PASSPHRASE=synthetic-passphrase-local-tests
PAYFAST_ITEM_NAME=BEAZT Local Test Order

IVNO_API_KEY=ivno_test_synthetic_api_key_local
IVNO_API_SECRET=ivno_test_synthetic_api_secret_local
IVNO_WEBHOOK_SECRET=ivno_test_synthetic_webhook_secret_local

# NFAHub reseller API (account storefront). Optional: empty disables the
# integration. Base URL defaults to https://nfahub.cc/api/reseller/v2.
NFAHUB_API_KEY=nfahub_test_synthetic_api_key_local
NFAHUB_API_BASE=https://nfahub.cc/api/reseller/v2

# Closed local port so development never contacts the real License API.
LICENSE_API_URL=http://127.0.0.1:9
LICENSE_API_TOKEN=license_test_synthetic_token_local
